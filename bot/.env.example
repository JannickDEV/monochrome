# --- Required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# --- Optional ----------------------------------------------------------------
# Register slash commands to one guild (instant) instead of globally (~1h).
# GUILD_ID=

# Music backends (defaults shown).
# DEV_MODE_URL=https://hf-core.bitperfect.dedyn.io
# QOBUZ_URL=https://qz-api.bitperfect.dedyn.io

# Optional Spotify app (id+secret) — fully reads ALBUM tracks via the Web API.
# PLAYLISTS are a different story: since Spotify's Nov-2024 lockdown, the
# playlist-tracks endpoint returns 403 for every app not in Extended Quota
# Mode, and a user SPOTIFY_REFRESH_TOKEN does NOT change that. Playlists
# therefore always fall back to the embed scraper (~100 tracks). The refresh
# token / spotify-auth flow is kept only in case Spotify ever grants quota.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ffmpeg binary. Defaults to the bundled ffmpeg-static, then system `ffmpeg`.
# FFMPEG_PATH=

# Audio/API proxy HTTP server (sits behind the VPS nginx).
# PROXY_PORT=8080
# PROXY_BIND=127.0.0.1

# Behaviour tuning.
# IDLE_DISCONNECT_MS=300000
# MAX_QUEUE_ADD=200
