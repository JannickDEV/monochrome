# --- Required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# --- Optional ----------------------------------------------------------------
# Register slash commands to one guild (instant) instead of globally (~1h).
# GUILD_ID=

# Music backends (defaults shown).
# DEV_MODE_URL=https://hf-core.bitperfect.dedyn.io
# QOBUZ_URL=https://qz-api.bitperfect.dedyn.io

# --- Spotify: full playlist reads (recommended) -----------------------------
# A refresh token for Spotify's own desktop client (the one librespot /
# OnTheSpot use). Tokens minted from it are the official-client identity, so
# GET /playlists/{id}/tracks works in full, past 100 — no developer app, no
# Extended Quota Mode. ToS-gray; private instances only.
#   bun run spotify-auth-fp
# Spotify rotates this token on every refresh — .env only seeds the first one;
# the bot then tracks the current value in bot/.spotify-fp-refresh-token.
# SPOTIFY_FIRSTPARTY_REFRESH_TOKEN=
# SPOTIFY_FIRSTPARTY_REDIRECT_URI=http://127.0.0.1:5588/login

# --- Spotify: self-registered dev app (fallback) ----------------------------
# id+secret fully reads ALBUM tracks via the Web API. PLAYLISTS do NOT work
# here: since Spotify's Nov-2024 lockdown the playlist-tracks endpoint 403s
# for every app not in Extended Quota Mode, and a user SPOTIFY_REFRESH_TOKEN
# does not change that — without the first-party token above, playlists fall
# back to the embed scraper (~100 tracks).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ffmpeg binary. Defaults to the bundled ffmpeg-static, then system `ffmpeg`.
# FFMPEG_PATH=

# Audio/API proxy HTTP server (sits behind the VPS nginx).
# PROXY_PORT=8080
# PROXY_BIND=127.0.0.1

# Behaviour tuning.
# IDLE_DISCONNECT_MS=300000
# MAX_QUEUE_ADD=200
